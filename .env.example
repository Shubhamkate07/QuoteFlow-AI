# ==============================================================================
# QuoteFlow AI - Unified Docker Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env before starting Docker Compose:
#    cp .env.example .env (Linux/macOS) OR Copy-Item .env.example .env (Windows)
# 2. Update POSTGRES_PASSWORD, SECRET_KEY, and GEMINI_API_KEY with your own values.
# 3. Never commit the populated .env file into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Django Settings
# ------------------------------------------------------------------------------
DJANGO_ENV=development
DEBUG=True

# In production: Generate a strong 50+ character random key:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=quoteflow-dev-secret-key-change-this-in-production-random-hash-123456

# ------------------------------------------------------------------------------
# 2. PostgreSQL Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=quoteflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis & Celery Task Queue
# ------------------------------------------------------------------------------
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Engine
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. Frontend & Network Settings
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
