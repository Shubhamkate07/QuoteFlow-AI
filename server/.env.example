# ==========================================
# QuoteFlow AI - Backend Environment Variables Template
# ==========================================
# Copy this file to .env and adjust variables for your local machine or production server.
# Command: Copy-Item .env.example .env

# Environment mode ('development' or 'production')
DJANGO_ENV=development

# Security settings
# In production: Generate a secure 50+ character random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,::1

# Database Configuration (PostgreSQL)
# In development, USE_SQLITE=True allows running without a live PostgreSQL instance.
# In production, set USE_SQLITE=False and provide your PostgreSQL credentials.
USE_SQLITE=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=quoteflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# CORS Configuration (React Frontend)
# Comma-separated list of trusted frontend origins. Never use wildcard (*) in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Django REST Framework Settings
DRF_PAGE_SIZE=20

# File Upload Memory Limits (in bytes - default 10MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# Production HTTPS & Security Flags (Only enforced when DJANGO_ENV=production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000
